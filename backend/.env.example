PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Configuration (Neon / Netlify)
DATABASE_URL=postgresql://usuario:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ar_studio
DB_USER=postgres
DB_PASSWORD=postgres

# Max file upload size in MB (e.g. 50MB for 3D models)
MAX_FILE_SIZE_MB=50

# Storage Provider Configuration (local o cloudinary)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=SU_NOMBRE_DE_NUBE
CLOUDINARY_API_KEY=SU_CLAVE_API
CLOUDINARY_API_SECRET=SU_SECRETO_API
